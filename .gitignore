# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/

# The example app is retired (#85); only example/example.md is versioned. Anything a local
# `flutter run` regenerates under example/ stays out: its ephemeral symlinks point into the
# developer's home directory, and a repository holding them breaks Argo CD for admoai/adhub,
# which fetches this one as a submodule (admoai/adhub#4585).
/example/*
!/example/example.md
